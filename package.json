{
  "name": "mapa-de-erros",
  "version": "0.1.0",
  "description": "Analisa padrões de erro de estudantes e sugere conteúdos para revisão",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  }
}
